# ═══════════════════════════════════════════════════
# Technical Documentation Platform — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════

# ── Application ──
TDP_ENVIRONMENT=development
TDP_APP_NAME=Technical Documentation Platform
TDP_API_PREFIX=/api

# ── Database ──
TDP_DATABASE_PATH=.runtime/tdp.sqlite3
TDP_ARTIFACT_ROOT_PATH=.runtime/artifacts

# ── Auth ──
# Options: "local" | "oidc"
TDP_AUTH_MODE=local

# ── Local Identity (development only) ──
TDP_LOCAL_IDENTITY_SUBJECT=local-technical-writer
TDP_LOCAL_IDENTITY_NAME=Technical Writer
TDP_LOCAL_IDENTITY_EMAIL=technical.writer@local.invalid

# ── OIDC (required when TDP_AUTH_MODE=oidc) ──
# TDP_OIDC_ISSUER=https://your-idp.example.com
# TDP_OIDC_CLIENT_ID=your-client-id
# TDP_OIDC_CLIENT_SECRET=your-client-secret
# TDP_OIDC_AUDIENCE=your-audience

# ── CORS ──
TDP_ALLOWED_ORIGINS=http://127.0.0.1:4173

# ── Rate Limiting ──
TDP_RATE_LIMIT_ENABLED=true
TDP_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ── Audit ──
TDP_AUDIT_ENABLED=true

# ── HSTS (production only) ──
TDP_HSTS_ENABLED=false
TDP_HSTS_MAX_AGE=31536000

# ── CSRF ──
TDP_CSRF_ENABLED=false
TDP_CSRF_COOKIE_SECURE=false

# ── Authorization ──
TDP_RBAC_ENABLED=true
TDP_DEFAULT_ADMIN_SUBJECTS=local-technical-writer

# ── Frontend ──
VITE_API_BASE_URL=http://127.0.0.1:8000/api