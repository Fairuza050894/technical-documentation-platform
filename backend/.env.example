
TDP_APP_NAME=Technical Documentation Platform
TDP_APP_VERSION=0.1.0
TDP_ENVIRONMENT=development
TDP_API_PREFIX=/api
TDP_ALLOWED_ORIGINS=["http://127.0.0.1:4173"]
TDP_DATABASE_PATH=.runtime/tdp.sqlite3
TDP_ARTIFACT_ROOT_PATH=.runtime/artifacts
TDP_MAX_SOURCE_FILE_BYTES=5242880

# Local identity is permitted only for development and test.
TDP_AUTH_MODE=local
TDP_LOCAL_IDENTITY_SUBJECT=local-technical-writer
TDP_LOCAL_IDENTITY_NAME=Technical Writer
TDP_LOCAL_IDENTITY_EMAIL=technical.writer@local.invalid

